<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/la_card_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/la_card_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/la_bg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFeatureSettings="tnum"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="@android:color/white"
                        android:textSize="46sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/la_arrow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textColor="#F2FFFFFF"
                        android:textSize="32sp"
                        android:textStyle="bold" />

            <ImageView
                android:id="@+id/la_arrow_img1"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:visibility="gone"
                android:importantForAccessibility="no" />

            <ImageView
                android:id="@+id/la_arrow_img2"
                android:layout_marginStart="-8dp"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical"
                android:visibility="gone"
                android:importantForAccessibility="no" />
                </LinearLayout>

                <TextView
                    android:id="@+id/la_delta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-medium"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="#CCFFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <ImageView
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="6dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="8dp"
                android:background="#33FFFFFF" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/la_slot0"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/la_slot0_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#C7FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/la_slot0_value"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeTextType="uniform"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/la_slot1"
                android:layout_width="72dp"
                android:layout_marginStart="12dp"
                android:layout_height="36dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/la_slot1_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#C7FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/la_slot1_value"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeTextType="uniform"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/la_slot2"
                android:layout_width="72dp"
                android:layout_height="36dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/la_slot2_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#C7FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/la_slot2_value"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeTextType="uniform"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/la_slot3"
                android:layout_width="72dp"
                android:layout_marginStart="12dp"
                android:layout_height="36dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/la_slot3_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#C7FFFFFF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/la_slot3_value"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeTextType="uniform"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/la_adjustments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:text="⏱"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/la_override"
                style="@style/LAAdjustmentText"
                android:ellipsize="end"
                android:maxWidth="160dp" />

            <Chronometer
                android:id="@+id/la_override_timer"
                style="@style/LAAdjustmentText"
                android:layout_marginStart="5dp" />

            <TextView
                android:id="@+id/la_adjust_separator"
                style="@style/LAAdjustmentText"
                android:layout_marginStart="5dp"
                android:text="·"
                android:textColor="#80FFFFFF" />

            <TextView
                android:id="@+id/la_temp_target"
                style="@style/LAAdjustmentText"
                android:layout_marginStart="5dp" />

            <Chronometer
                android:id="@+id/la_temp_target_timer"
                style="@style/LAAdjustmentText"
                android:layout_marginStart="5dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/la_cgm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/la_updated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="#A6FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/la_card_stroke" />

    <FrameLayout
        android:id="@+id/la_not_looping"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <ImageView
            android:id="@+id/la_not_looping_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/la_card_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.075"
                android:text="Not Looping"
                android:textColor="@android:color/white"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/la_not_looping_cgm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
