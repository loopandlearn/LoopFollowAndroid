<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <LinearLayout
        android:id="@+id/dream_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/dream_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:textColor="#99FFFFFF"
            android:textSize="28sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/dream_bg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="—"
                android:textColor="@android:color/white"
                android:textSize="112sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dream_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textSize="64sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/dream_arrow_img1"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="8dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/dream_arrow_img2"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginStart="-20dp"
                android:importantForAccessibility="no"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/dream_delta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="#DDFFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/dream_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:textColor="#99FFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/dream_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:maxLines="1"
            android:textColor="#FFFF3B30"
            android:textSize="22sp"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
